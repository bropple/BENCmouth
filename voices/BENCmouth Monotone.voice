# BENCmouth voice
name           = BENCmouth Monotone

f0_base        = 120
f0_range       = 0
f0_flutter     = 0
vibrato        = 0
vibrato_rate   = 0
speed          = 1

throat         = 1
mouth          = 1

breathiness    = 0
tilt           = 4
open_quotient  = 0.5
whisper        = 0
gain           = 0.62

# naturalness controls; 0 is the original BENCmouth behaviour
coarticulation = 0
prosody        = 0
formant_glide  = 0
bandwidth_track= 0

# This is the line that actually delivers the name, and this file went without
# it for a release. `f0_range = 0` is read only by the phrase planner, which
# this voice does not use, so the older contour went on applying its 18%
# declination and its 6% bump on stressed syllables and the file swung 28.5% in
# pitch - the same spread as BENCmouth Retro. One pitch for the whole utterance,
# and every vowel its nominal length whatever stress it carries.
flatten        = 1

# BENCmouth song
#
# Public domain: 1814 lyrics, 1780s melody ("To Anacreon in Heaven").
#
# Key of C major. Pitches sourced from a published letter-note transcription
# and cross-checked against the anthem's documented range of 19 semitones,
# C4 up to G5 - the "can you SEE" leap and the "land of the FREE" climax both
# land where they should. The rhythms are a reasonable approximation, with
# phrase-final words held long and melismas in quick eighths; they are not
# checked against a rhythm-accurate source, so treat the durations as a first
# draft even though the pitches are solid.
#
# tempo = 88 per standard published arrangements. At that tempo an eighth is
# 341 ms, a quarter 682, a dotted quarter 1023, a half 1364 and a dotted half
# 2045 - which is where every [hold] below comes from.
#
#   ./bm -S songs/star-spangled-banner.bmsong -a

title           = The Star-Spangled Banner (Verse 1)
voice           = BENCmouth
tempo           = 88
vibrato         = 0.22
prosody         = 0

# Two settings the score did not name, both measured rather than chosen.
#
# Flutter down from the 0.30 default, matching songs/daisy.bmsong. Flutter is
# aperiodic jitter and it exists to keep *speech* from buzzing; on a note held
# for two seconds it is just an unsteady note. Vibrato above is the periodic
# modulation a sung note actually wants, and the two do different jobs.
f0_flutter      = 0.18

# At unity this peaked at 0.975 against a limiter that engages at 0.85 - it was
# clipping, which is what "driven pretty hard" sounds like. Sustained notes with
# prosody off stack peaks the way any flutter-free voice does: the resonators
# are excited in lockstep and the peaks line up. 0.75 lands it at 0.745.
gain            = 0.75

score =

# BENCmouth song
#
# The Star-Spangled Banner. Words by Francis Scott Key, 1814; the tune is
# "To Anacreon in Heaven", John Stafford Smith, c.1773. Both long in the
# public domain.
#
# Transcribed from a recording of a much older formant synthesizer singing it -
# 85 seconds of 7 kHz 8-bit mono, which is a provenance you can hear. The
# melody here is that recording's, pitch-tracked note by note: D major, with
# the voice sitting between D2 and A3. The chromatic F#-G#-A rise at the end of
# each long phrase is in the original and is not an artifact - it is the raised
# fourth the tune has always had.
#
# The voice is aimed at the same target by measurement rather than by ear.
# Energy in five bands, this rendering put through the reference's own format
# so the comparison is like for like:
#
#                        <500   .5-1k   1-2k   2-3k   >3k
#   reference            15.2%  19.8%  33.2%  20.2%  11.5%
#   this song, 22 kHz    17.0%  28.4%  30.9%  15.5%   8.3%
#   this song at -r 7000 14.3%  26.7%  32.2%  19.9%   6.9%
#
# The lever turned out to be `throat`, not `tilt`. The reference has almost no
# energy below 500 Hz for a voice whose fundamental is 92 Hz, which means its
# formants sit far higher than that pitch has any business implying - so throat
# goes to 1.35, the child end of a range meant for a short vocal tract, under a
# voice down at D2. No human is shaped like that. That is the sound: a machine
# with a small mouth and a big larynx, which is what you get when the two were
# never tied to each other in the first place.
#
# Rendered at the reference's own 7 kHz the match is closest - three of the
# four bands that matter land within a point. The remaining gap is above 3 kHz,
# where the reference has energy a 7 kHz recording cannot actually carry: that
# is its resampler, not its voice, and fitting it would be fitting an artifact.
#
#   ./bm -S songs/star-spangled-banner.bmsong -a

title          = The Star-Spangled Banner
voice          = BENCmouth
# 96 BPM: the reference's shortest notes land near 300 ms, which is an eighth
# at this tempo. The holds below are the reference's own note lengths scaled by
# 0.82 - its pitch-tracked "notes" include its voiced consonants, and here the
# consonants get their own time on top, so the vowels have to give some back.
# At 0.82 this runs 85.25 s against the reference's 84.90.
tempo          = 96

f0_base        = 110
f0_range       = 0
f0_flutter     = 0.15
vibrato        = 0
vibrato_rate   = 0
source         = 0
speed          = 1

throat         = 1.35
mouth          = 1

breathiness    = 0
# Low, and that is the whole timbre. Measured against the reference: at 1632 Hz
# a voice down at 92 Hz has to be barely tilted at all.
tilt           = 0
open_quotient  = 0.3
whisper        = 0
gain           = 0.55

# A machine from before any of this was a parameter.
coarticulation = 0.2
prosody        = 0
formant_glide  = 0
bandwidth_track= 0
flatten        = 0

# No crush. It was the obvious way to reach for the 8-bit-ness of the source
# and it was the wrong one: crush reduces the sample *rate*, and doing that at
# 22050 aliases energy upward into a band the reference does not have at all -
# it is 7 kHz, so it cannot. Measured, it moved the spectrum away from the
# target rather than toward it. For the period band limit, render at the
# reference's own rate instead:
#
#   ./bm -S songs/star-spangled-banner.bmsong -r 7000 -o period.wav
#
# That rate used to produce garbage, and finding out why is the reason
# bm_resonator gained a band limit - see the note in bm_resonator.c.

score =
[note A2][hold 229] OW1
[note F#2][hold 245] S EY1
[note D2][hold 671] K AE1 N
[note F#2][hold 572] Y UW1
[note A2][hold 499] S IY1
